{
  "name": "create-my-docs",
  "version": "0.1.0",
  "description": "基于 VitePress 官方脚手架扩展的团队文档站生成器:内置多语言、CI/CD、自动生成 nav/sidebar 与升级机制",
  "type": "module",
  "license": "MIT",
  "bin": {
    "create-my-docs": "bin/cli.js"
  },
  "files": [
    "bin",
    "dist",
    "template"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --target node18 --clean",
    "dev": "tsx src/index.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:e2e": "RUN_E2E_SMOKE=1 vitest run",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@clack/prompts": "^0.9.0",
    "ejs": "^3.1.10",
    "execa": "^9.5.0",
    "giget": "^1.2.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^3.0.0",
    "@types/ejs": "^3.1.5",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
