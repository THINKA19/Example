{
  "name": "create-vitepress-template",
  "type": "module",
  "version": "1.0.0",
  "description": "VitePress project scaffold",
  "license": "ISC",
  "scripts": {
    "dev": "vitepress dev",
    "build": "vitepress build",
    "preview": "vitepress preview",
    "preinstall": "npx only-allow pnpm",
    "typecheck": "vue-tsc --noEmit",
    "sidebar:generate": "tsx scripts/generate-sidebar.ts"
  },
  "dependencies": {
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitepress": "2.0.0-alpha.20",
    "vue-tsc": "^2.2.12"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.22.0",
      "onFail": "download"
    }
  }
