.env.production
.npmrc

# ==============================================================================
# 1. 通用产物与依赖 (Universal - 99% 的 Node.js / Vite / VitePress 项目必配)
# ==============================================================================
# 依赖包目录
node_modules/

# 常见构建产物目录 (VitePress 打包默认输出到 .vitepress/dist，这里统一覆盖)
dist/
.vitepress/dist/
.vitepress/cache/

# 环境变量与本地私密配置 (绝对不能提交到远程仓库)
.env
.env.local
.env.*.local

# 操作系统自动生成的讨厌文件
.DS_Store
Thumbs.db

# 常见日志文件
*.log
debug.log
local.log

# ==============================================================================
# 2. 项目与工程特化配置 (Project Specific - 针对脚本缓存、测试及特定工具)
# ==============================================================================
# 临时文件与草稿目录
temp/
explorations/
tracing_output/
cache/

# 单元测试 & 代码覆盖率报告 (Vitest / Jest / NYC)
coverage/
.nyc_output/
.rpt2_cache/
tsconfig.vitest-temp.json

# 本地包调试工具 (Yalc)
.yalc/
yalc.lock

# E2E 自动化测试日志 (Selenium / BrowserStack)
selenium-server.log
_selenium-server.log
browserstack.err

# IDE / 编辑器专属配置目录 (视团队规范而定)
.idea/
.cursor/

# AI 辅助工具本地特化配置 (Claude Desktop / Osgrep / Erudita / DeepSec)
.claude/settings.local.json
.claude/worktrees/
.osgrep/
.erudita/
.deepsec/

# 特殊忽略规则：忽略子包下的 LICENSE (如果是 Monorepo 架构)
packages/*/LICENSE