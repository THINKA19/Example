# ==========================================
# 1、镜像加速（国内推荐）
# ==========================================
# 国内淘宝/阿里云 npm 镜像源 
registry=https://registry.npmmirror.com/

# ==========================================
# 2、发布相关配置
# ==========================================
# 发布时使用官方源（避免镜像源发布失败）
# //registry.npmjs.org/:_authToken=${NPM_TOKEN}
//registry.npmjs.org/:_authToken=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

# ==========================================
# 3、pnpm 行为优化
# ==========================================
# 自动安装缺失的 peer 依赖，减少依赖报错
auto-install-peers=true