# ==========================================
# 1. 依赖与构建产物 (必须过滤，由 Docker 内部重新构建)
# ==========================================
node_modules
dist
.output
.vitepress/cache
.vitepress/dist

# ==================== 2. 版本控制与 CI/CD 配置 ====================
.git
.gitignore
.github
.gitee

# ==================== 3. IDE、编辑器与系统临时文件 ====================
.vscode
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# ==================== 4. 日志与调试文件 ====================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==================== 5. 文档与临时文件 ====================
README.md
README_*.md
LICENSE
*.mb
.temp

# ==================== 6. 环境变量与敏感信息文件 ====================
# 避免将本地的敏感密钥或本地测试环境变量打包进容器
.env*.local
.env.development